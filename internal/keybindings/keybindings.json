{
  "version": "1.0",
  "description": "Single source of truth for all grut keyboard shortcuts. Embedded by the help overlay and used to generate docs/keybindings.md.",
  "sections": [
    {
      "id": "global",
      "title": "Global",
      "description": "Always active regardless of focused panel.",
      "bindings": [
        { "key": "1-5", "action": "Focus panel by number" },
        { "key": "ctrl+b z", "action": "Zoom focused panel" },
        { "key": "R", "action": "Refresh all data + preview" },
        { "key": "P", "action": "Push to remote" },
        { "key": "F", "action": "Fetch all remotes" },
        { "key": "?", "action": "Help overlay" },
        { "key": ",", "action": "Settings" },
        { "key": "/", "action": "Fuzzy finder" },
        { "key": ":", "action": "Command palette" },
        { "key": "~", "action": "Change directory" },
        { "key": "T", "action": "Find TODO/FIXME markers" },
        { "key": "ctrl+space", "action": "Toggle AI chat" },
        { "key": "ctrl+z", "action": "Undo last git action" },
        { "key": "ctrl+y", "action": "Redo" },
        { "key": "ctrl+c", "action": "Quit" }
      ]
    },
    {
      "id": "navigation",
      "title": "Navigation",
      "description": "Consistent in every focused panel.",
      "bindings": [
        { "key": "j/k", "action": "Cursor down/up" },
        { "key": "g/G", "action": "Jump to top/bottom" },
        { "key": "PgDn/PgUp", "action": "Page down/up" },
        { "key": "Enter", "action": "Select / open / expand" },
        { "key": "Esc", "action": "Back / close submode" },
        { "key": "d", "action": "Discard changes to selected file" },
        { "key": "u", "action": "Unstage selected file" }
      ]
    },
    {
      "id": "filetree",
      "title": "File Tree",
      "description": "File Tree panel (panel 1).",
      "bindings": [
        { "key": "h/l", "action": "Collapse/expand directory" },
        { "key": "H/L", "action": "Collapse/expand all directories" },
        { "key": "o", "action": "Open in external editor" },
        { "key": "M", "action": "Reveal in OS file manager" },
        { "key": "B", "action": "Open on GitHub" },
        { "key": ".", "action": "Toggle hidden files" },
        { "key": "f", "action": "Toggle git filter" },
        { "key": "v", "action": "Toggle tree/list view" },
        { "key": "n", "action": "New file" },
        { "key": "N", "action": "New directory" },
        { "key": "x", "action": "Delete file/directory" },
        { "key": "e / F2", "action": "Rename" },
        { "key": "y", "action": "Copy path to clipboard" },
        { "key": "c", "action": "Copy file" },
        { "key": "p", "action": "Paste file" },
        { "key": "space", "action": "Toggle stage/unstage" },
        { "key": "I", "action": "Add selected entry to .gitignore" },
        { "key": "J/K", "action": "Scroll preview down/up" }
      ]
    },
    {
      "id": "gitstatus",
      "title": "Git Status",
      "description": "Active when the file tree is in git filter mode (press f to cycle).",
      "bindings": [
        { "key": "s", "action": "Stage file/hunk/line" },
        { "key": "u", "action": "Unstage file/hunk/line" },
        { "key": "d", "action": "Discard unstaged changes" },
        { "key": "y", "action": "Copy the current diff hunk (or file path) to the clipboard" },
        { "key": "c", "action": "Commit staged changes" },
        { "key": "p", "action": "Pull from remote" },
        { "key": "a", "action": "Stage all" },
        { "key": "U", "action": "Unstage all" },
        { "key": "space", "action": "Toggle select for bulk" },
        { "key": "enter/l", "action": "Expand file diff" },
        { "key": "h", "action": "Enter hunk mode" },
        { "key": "X", "action": "Clean untracked files (preview and select)" },
        { "key": "Esc", "action": "Exit hunk/line mode" }
      ]
    },
    {
      "id": "gitinfo",
      "title": "Git Info",
      "description": "Git Info panel (panel 2).",
      "bindings": [
        { "key": "Tab", "action": "Next tab" },
        { "key": "Shift+Tab", "action": "Previous tab" },
        { "key": "b", "action": "Branches tab" },
        { "key": "w", "action": "Worktrees tab" },
        { "key": "r", "action": "Remotes tab" },
        { "key": "s", "action": "Stash tab" },
        { "key": "t", "action": "Tags tab" },
        { "key": "l", "action": "Reflog tab" },
        { "key": "n", "action": "Create new item" },
        { "key": "x", "action": "Delete selected" },
        { "key": "e / F2", "action": "Rename" },
        { "key": "o", "action": "Open in browser" },
        { "key": "y", "action": "Copy to clipboard" },
        { "key": "f", "action": "Fetch / filter" },
        { "key": "P", "action": "Push tag" }
      ]
    },
    {
      "id": "github",
      "title": "GitHub",
      "description": "GitHub panel (panel 3).",
      "bindings": [
        { "key": "Tab", "action": "Next tab" },
        { "key": "Shift+Tab", "action": "Previous tab" },
        { "key": "b", "action": "Branches tab" },
        { "key": "t", "action": "Tags tab" },
        { "key": "i", "action": "Issues tab" },
        { "key": "p", "action": "Pull Requests tab" },
        { "key": "a", "action": "Actions tab" },
        { "key": "w", "action": "Workflows tab" },
        { "key": "l", "action": "Releases tab" },
        { "key": "n", "action": "Create issue (Issues tab) / Create pull request (PRs tab)" },
        { "key": "N", "action": "Notifications tab" },
        { "key": "Enter", "action": "Open notification in browser (Notifications tab)" },
        { "key": "o", "action": "Open in browser" },
        { "key": "y", "action": "Copy to clipboard" },
        { "key": "m", "action": "Merge PR (PRs tab) / Mark read (Notifications tab)" },
        { "key": "M", "action": "Copy issue or PR as a markdown link (Issues/PRs tabs)" },
        { "key": "A", "action": "Assign to me (Issues/PRs tab)" },
        { "key": "R", "action": "Request reviewers (PRs tab)" },
        { "key": "C", "action": "Comment on issue/PR (Issues/PRs tab)" },
        { "key": "c", "action": "Close/reopen issue (Issues tab)" },
        { "key": "S", "action": "Cycle state filter open/closed/all (Issues/PRs tab)" },
        { "key": "r", "action": "Rerun (Actions tab) / Refresh (Notifications tab)" },
        { "key": "x", "action": "Cancel (Actions tab)" },
        { "key": "D", "action": "Dispatch workflow" }
      ]
    },
    {
      "id": "commits",
      "title": "Commits",
      "description": "Commits panel (panel 4).",
      "bindings": [
        { "key": "Enter", "action": "View commit detail" },
        { "key": "Esc", "action": "Back to list" },
        { "key": "o", "action": "Open commit on GitHub" },
        { "key": "y", "action": "Copy SHA" },
        { "key": "a", "action": "Filter the commit log by the selected commit's author" },
        { "key": "x", "action": "Export the selected commit as a .patch file" },
        { "key": "A", "action": "Amend last commit" },
        { "key": "r", "action": "Reword last commit" },
        { "key": "v", "action": "Revert the selected commit" },
        { "key": "/", "action": "Search commits" },
        { "key": "S", "action": "Search commit content (pickaxe)" },
        { "key": "M", "action": "Search commit messages (grep)" }
      ]
    },
    {
      "id": "preview",
      "title": "Preview",
      "description": "Preview panel (panel 5).",
      "bindings": [
        { "key": "e", "action": "Edit file inline" },
        { "key": "f", "action": "Toggle diff view" },
        { "key": "j/k", "action": "Scroll content" },
        { "key": "g/G", "action": "Jump to top/bottom" },
        { "key": "L", "action": "Go to line" },
        { "key": "t", "action": "Jump to markdown heading" },
        { "key": "PgDn/PgUp", "action": "Page down/up" },
        { "key": "W", "action": "Toggle word wrap" },
        { "key": "n", "action": "Toggle line numbers" },
        { "key": "m", "action": "Toggle markdown render" },
        { "key": "B", "action": "Toggle blame" },
        { "key": "y/Ctrl+C", "action": "Copy selection" },
        { "key": "Y", "action": "Copy GitHub permalink" },
        { "key": "O", "action": "Open file on GitHub" },
        { "key": "Ctrl+G", "action": "Create secret gist" },
        { "key": "Esc", "action": "Clear selection" }
      ],
      "note": "Navigation keys (j/k/g/G/PgDn/PgUp) scroll content. Click+drag to select text, double-click to select a word."
    },
    {
      "id": "gitdiff",
      "title": "Diff Viewer",
      "description": "Diff viewer panel for file, commit, branch, and PR diffs.",
      "bindings": [
        { "key": "j/k", "action": "Scroll up/down" },
        { "key": "d/u", "action": "Page down/up" },
        { "key": "g/G", "action": "Jump to top/bottom" },
        { "key": "t", "action": "Toggle inline/side-by-side" },
        { "key": "n/N", "action": "Next/previous hunk" },
        { "key": "[/]", "action": "Previous/next file" },
        { "key": "w", "action": "Toggle word-level diff" },
        { "key": "W", "action": "Toggle ignore whitespace" },
        { "key": "y", "action": "Copy the current hunk to the clipboard" },
        { "key": "R", "action": "Toggle review annotations" },
        { "key": "+/-", "action": "More/less diff context lines" },
        { "key": "0", "action": "Reset diff context to default" }
      ]
    },
    {
      "id": "help",
      "title": "Help Overlay",
      "description": "Active when the help overlay is open.",
      "bindings": [
        { "key": "/", "action": "Filter shortcuts by section, key, or action" },
        { "key": "j/k", "action": "Scroll help content" },
        { "key": "Enter", "action": "Keep the current filter and leave filter input" },
        { "key": "Esc", "action": "Clear filter, or close help when no filter is active" },
        { "key": "?", "action": "Close help" }
      ]
    },
    {
      "id": "edit_mode",
      "title": "Edit Mode",
      "description": "Active when editing a file inline (press e in Preview to enter).",
      "bindings": [
        { "key": "Ctrl+S", "action": "Save file" },
        { "key": "Ctrl+Z", "action": "Undo" },
        { "key": "Ctrl+Y", "action": "Redo" },
        { "key": "Ctrl+C", "action": "Copy selection (or line)" },
        { "key": "Ctrl+X", "action": "Cut selection (or line)" },
        { "key": "Ctrl+V", "action": "Paste from clipboard" },
        { "key": "Ctrl+A", "action": "Select all" },
        { "key": "Ctrl+D", "action": "Duplicate line" },
        { "key": "Ctrl+Shift+K", "action": "Delete line" },
        { "key": "Alt+Up/Down", "action": "Move line up/down" },
        { "key": "Ctrl+Left/Right", "action": "Word navigation" },
        { "key": "Ctrl+Backspace", "action": "Delete word left" },
        { "key": "Ctrl+Delete", "action": "Delete word right" },
        { "key": "Ctrl+Home/End", "action": "Jump to file start/end" },
        { "key": "Home/End", "action": "Jump to line start/end" },
        { "key": "Shift+Arrows", "action": "Extend selection" },
        { "key": "Shift+Home/End", "action": "Select to line start/end" },
        { "key": "Ctrl+Shift+Left/Right", "action": "Select word" },
        { "key": "Tab", "action": "Indent" },
        { "key": "Shift+Tab", "action": "Dedent" },
        { "key": "Esc", "action": "Exit edit mode" }
      ],
      "note": "Mouse: click to position cursor, drag to select, double-click to select word. Paste also works via terminal bracketed paste (Ctrl+V in most terminals)."
    }
  ]
}
